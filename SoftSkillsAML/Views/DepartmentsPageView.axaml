<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="using:SoftSkillsAML.Converters"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="SoftSkillsAML.DepartmentsPageView"
             xmlns:vm="using:SoftSkillsAML.ViewModels"
             x:DataType="vm:DepartmentsPageViewModel">
  <UserControl.Resources><conv:BytesToImageConverter x:Key="BytesToImageConverter"/></UserControl.Resources>
  <Grid Margin="16" ColumnDefinitions="220,*" ColumnSpacing="16">
    <Border Classes="card" Padding="12"><StackPanel Spacing="10"><TextBlock Text="Навигация" FontWeight="Bold" FontSize="18"/>
            <Button Classes="navButton" Content="Личный кабинет" Command="{Binding OpenProfile}"/>
      <Button Classes="navButton" Content="Выйти" Command="{Binding Logout}" Background="#64748B"/>
    </StackPanel></Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <TextBlock FontSize="24" FontWeight="Bold" Text="Список направлений" Margin="0,0,0,12"/>
      <ListBox Grid.Row="1" ItemsSource="{Binding Departments}" SelectedItem="{Binding SelectedDepartment}" DoubleTapped="DepartmentDoubleTapped">
        <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#764ba2" BorderThickness="1.5" Padding="8" Margin="6" CornerRadius="12"><StackPanel Width="140" Height="150" Spacing="8"><Image Height="90" Stretch="Uniform" Source="{Binding Image, Converter={StaticResource BytesToImageConverter}}"/><TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>
