<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="SoftSkillsAML.QuestionsPageView"
             xmlns:vm="using:SoftSkillsAML.ViewModels"
             x:DataType="vm:QuestionsPageViewModel">
  <Grid Margin="24" RowDefinitions="Auto,Auto,*" RowSpacing="14">
    <Border Classes="card" Padding="20">
      <StackPanel>
        <TextBlock Text="{Binding DepartmentName}" FontSize="30" FontWeight="Bold"/>
        <TextBlock Text="{Binding DepartmentDescription}" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.8"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
      <Button Content="Открыть задание" Command="{Binding OpenQuestion}"/>
      <Button Grid.Column="1" Content="Назад к направлениям" Command="{Binding BackToDepartments}" Background="#64748B"/>
    </Grid>

    <Border Grid.Row="2" Classes="card" Padding="12">
      <ListBox ItemsSource="{Binding Questions}" SelectedItem="{Binding SelectedQuestion}" Background="Transparent" BorderThickness="0">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" ItemWidth="408"/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14" Margin="6">
              <StackPanel Width="372" Spacing="6">
                <TextBlock Text="{Binding Number, StringFormat=Задание №{0}}" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding IsAnswered, StringFormat=Пройдено: {0}}" Opacity="0.75"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </Grid>
</UserControl>
