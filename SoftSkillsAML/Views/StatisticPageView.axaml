<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia" mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800" x:Class="SoftSkillsAML.StatisticPageView" xmlns:vm="using:SoftSkillsAML.ViewModels" x:DataType="vm:StatisticPageViewModel"><Grid Margin="16" ColumnDefinitions="220,*" ColumnSpacing="16"><Border Classes="card" Padding="12"><StackPanel Spacing="10"><TextBlock Text="Навигация" FontWeight="Bold" FontSize="18"/><Button Classes="navButton" Content="Пользователи" Command="{Binding OpenUsers}"/><Button Classes="navButton" Content="Добавить задание" Command="{Binding OpenAddQuestion}"/><Button Classes="navButton" Content="Добавить достижение" Command="{Binding OpenAddAchievement}"/><Button Classes="navButton" Content="Направления" Command="{Binding OpenDepartmentsEdit}"/><Button Classes="navButton" Content="Выйти" Command="{Binding Logout}"/></StackPanel></Border><ScrollViewer Grid.Column="1"><Grid RowDefinitions="Auto,Auto,Auto,*"><TextBlock Text="Статистика администратора" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/><Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" Padding="10" Margin="0,0,0,12"><StackPanel><TextBlock Text="Конверсия по направлениям" FontSize="16" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding DepartmentConversion}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Width="240" Margin="6"><TextBlock Text="{Binding Name}"/><lvc:PieChart Series="{Binding Series}" Height="170"/><TextBlock Text="{Binding Percent, StringFormat={}{0}%}" HorizontalAlignment="Center"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" Padding="10" Margin="0,0,0,12"><StackPanel><TextBlock Text="Средние показатели навыков" FontSize="16" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding SkillsAverages}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Width="240" Margin="6"><TextBlock Text="{Binding Name}"/><lvc:PieChart Series="{Binding Series}" Height="170"/><TextBlock Text="{Binding Percent, StringFormat={}{0}%}" HorizontalAlignment="Center"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Grid.Row="3" BorderBrush="#DDD" BorderThickness="1" Padding="10"><StackPanel><TextBlock Text="Распределение возрастов пользователей (0-100)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/><lvc:CartesianChart Series="{Binding AgeDistributionSeries}" XAxes="{Binding AgeDistributionXAxes}" Height="260"/></StackPanel></Border></Grid></ScrollViewer></Grid></UserControl>